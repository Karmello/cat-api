{
  "name": "cat-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.13.0"
  },
  "scripts": {
    "build": "rimraf build && cross-env NODE_ENV=production webpack --config config/webpack.config",
    "heroku-prebuild": "yarn clone-shared",
    "start": "cross-env NODE_ENV=production node build/index.js",
    "start-local": "cross-env nodemon -L --exec ts-node -r tsconfig-paths/register src/index.ts",
    "prettier": "prettier --check src/**/*.ts",
    "prettify": "prettier --write src/**/*.ts",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test mocha -r ts-node/register -r tsconfig-paths/register src/**/*.spec.ts --timeout 10000 --exit",
    "test-int": "cross-env NODE_ENV=test mocha -r ts-node/register -r tsconfig-paths/register tests/index.ts --timeout 25000 --exit",
    "clone-shared": "git clone https://$PAT@github.com/Karmello/cat-shared.git src/ext/cat-shared",
    "prepare": "husky install",
    "db": "ts-node -r tsconfig-paths/register ./db/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@honeybadger-io/js": "^6.10.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "date-fns": "^3.2.0",
    "express": "^4.21.2",
    "generate-password": "^1.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.15",
    "mongoose": "^7.8.4",
    "mongoose-unique-validator": "^5.0.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.9",
    "openai": "^4.79.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/register": "^7.25.9",
    "@faker-js/faker": "^9.4.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.17.14",
    "@types/mocha": "^10.0.1",
    "@types/mongoose-unique-validator": "^1.0.7",
    "@types/morgan": "^1.9.4",
    "@types/node": "^22.10.6",
    "@types/nodemailer": "^6.4.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-loader": "^9.1.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "chai": "4.4.0",
    "chai-http": "^4.4.0",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "mocha": "^11.0.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^6.1.3",
    "typescript": "^5.7.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "resolutions": {
    "mongoose": ">=7.4.4",
    "engine.io": ">=6.4.2",
    "got": ">=11.8.5"
  }
}
